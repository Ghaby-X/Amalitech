MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_HOST=db
MYSQL_PORT=3306
WEB_PORT=5000

MYSQL_PASSWORD=apppassword
MYSQL_ROOT_PASSWORD=rootpassword

# EC2 deployment only - leave unset for local docker compose.
# When set, web/app.py fetches MYSQL_PASSWORD from this Secrets Manager
# secret via the instance's IAM role instead of using MYSQL_PASSWORD above.
# The db (mysql) container still needs MYSQL_PASSWORD/MYSQL_ROOT_PASSWORD
# above set directly - the deploy step writes those from the same secret.
# AWS_SECRET_NAME=lab-dom06/db-credentials
# AWS_REGION=eu-west-1
