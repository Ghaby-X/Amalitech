{
  "containerDefinitions": [
    {
      "name": "shopnow-postgres",
      "image": "postgres:16-alpine",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 5432,
          "hostPort": 5432,
          "protocol": "tcp",
          "name": "shopnow-postgres-5432-tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "POSTGRES_USER",
          "value": "shopnow"
        },
        {
          "name": "POSTGRES_DB",
          "value": "shopnow"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [
        {
          "sourceVolume": "postgres-data",
          "containerPath": "/var/lib/postgresql/data",
          "readOnly": false
        }
      ],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "/lab-dom11-shopnow/postgres/password"
        }
      ],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lab-dom11-shopnow",
          "awslogs-create-group": "true",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "postgres"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "lab-dom11-shopnow-postgres-task-def",
  "executionRoleArn": "arn:aws:iam::711387121692:role/lab-dom11-shopnow-ecs-task-execution",
  "networkMode": "awsvpc",
  "volumes": [
    {
      "name": "postgres-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-06a2ba515cc060a0c",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-09dc211008a9a3db1",
          "iam": "DISABLED"
        }
      }
    }
  ],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072",
  "enableFaultInjection": false,
  "tags": []
}
